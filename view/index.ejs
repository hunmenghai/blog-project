
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>My Blog</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="site-header">
    <nav class="navbar navbar-expand-lg">
      <div class="container">
        <a class="navbar-brand" href="/">My Blog</a>

        <a href="/new" class="btn btn-primary">
          New post
        </a>
      </div>
    </nav>
  </header>

  <main>
    <section class="intro py-5 text-center">
      <div class="container">
        <p class="eyebrow mb-2">A place for your ideas</p>

        <h1 class="display-4 fw-bold">
          Welcome to my blog
        </h1>

        <p class="lead text-body-secondary mx-auto mb-0">
          Notes, stories, and things worth remembering.
        </p>
      </div>
    </section>

    <section class="post-library py-5">
      <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="h3 mb-0">Latest posts</h2>

          <span class="post-count">
            <%= posts.length %>
            <%= posts.length === 1 ? "post" : "posts" %>
          </span>
        </div>

        <% if (posts.length === 0) { %>

          <div class="empty-state text-center py-5">
            <h3 class="h4">
              Your blog is ready for its first post.
            </h3>

            <p class="text-body-secondary mb-4">
              Start writing and your newest ideas will appear here.
            </p>

            <a href="/new" class="btn btn-primary">
              Create your first post
            </a>
          </div>

        <% } else { %>

          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">

            <% posts.forEach(post => { %>

              <article class="col">
                <div class="card post-card h-100">
                  <div class="card-body d-flex flex-column">

                    <h3 class="card-title h4">
                      <a
                        href="/posts/<%= post.id %>"
                        class="post-title-link"
                      >
                        <%= post.title %>
                      </a>
                    </h3>

                    <p class="card-text text-body-secondary flex-grow-1">
                      <%= post.content
                        .replace(/[#*_>`~-]/g, "")
                        .replace(/\s+/g, " ")
                        .trim()
                        .slice(0, 180) %><%= post.content.trim().length > 180 ? "..." : "" %>
                    </p>

                    <div class="mb-3">
                      <a
                        href="/posts/<%= post.id %>"
                        class="read-more-link"
                      >
                        Read more →
                      </a>
                    </div>

                    <div class="post-actions pt-3 mt-3 border-top">
                      <a
                        href="/posts/<%= post.id %>/edit"
                        class="btn btn-outline-primary btn-sm"
                      >
                        Edit
                      </a>

                      <form
                        method="POST"
                        action="/posts/<%= post.id %>/delete"
                        class="d-inline"
                        onsubmit="return confirm('Are you sure you want to delete this post?');"
                      >
                        <button
                          class="btn btn-outline-danger btn-sm"
                          type="submit"
                        >
                          Delete
                        </button>
                      </form>
                    </div>

                  </div>
                </div>
              </article>

            <% }) %>

          </div>

        <% } %>

      </div>
    </section>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <p class="mb-0 text-body-secondary">
        Write something worth sharing.
      </p>
    </div>
  </footer>
</body>
</html>
