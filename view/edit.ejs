<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Post</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header">
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" href="/">My Blog</a>
                <a href="/" class="btn btn-outline-primary">Back to posts</a>
            </div>
        </nav>
    </header>

    <main class="form-page py-5">
        <div class="container">
            <div class="form-shell mx-auto">
                <p class="eyebrow mb-2">Refine your entry</p>
                <h1 class="display-5 fw-bold mb-2">Edit your post</h1>
                <p class="text-body-secondary mb-4">Make a thoughtful update before publishing it again.</p>

                <form method="POST" action="/posts/<%= post.id %>/edit">
                    <div class="mb-4">
                        <label class="form-label" for="title">Title</label>
                        <input class="form-control form-control-lg" id="title" type="text" name="title" value="<%= post.title %>" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="content">Content</label>
                        <textarea class="form-control" id="content" name="content" rows="9" required><%= post.content %></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>