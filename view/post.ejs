
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= post.title %> | My Blog</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="site-header">
    <nav class="navbar navbar-expand-lg">
      <div class="container">
        <a class="navbar-brand" href="/">My Blog</a>
        <a href="/" class="btn btn-outline-primary">All posts</a>
      </div>
    </nav>
  </header>

  <%
    const imageByTitle = {
      "Are We Destined to Stay Poor If We Are Born Poor?": "/images/poverty.jpg",
      "Why We Avoid the Things We Most Need to Do": "/images/procrastination.jpg",
      "Why We Compare Ourselves to Others": "/images/comparison.jpg",
      "Why Learning Slowly Is Not the Same as Failing": "/images/learning.jpg"
    };

    const postImage = imageByTitle[post.title];
  %>

  <main class="container py-5">
    <article class="article-page mx-auto">

      <% if (postImage) { %>
        <img
          src="<%= postImage %>"
          alt="<%= post.title %>"
          class="article-featured-image"
        >
      <% } %>

      <div class="article-body">
        <h1 class="article-title"><%= post.title %></h1>

        <div class="post-content article-content">
          <%- post.contentHtml %>
        </div>

        <div class="article-actions mt-5 pt-4 border-top">
          <a href="/" class="btn btn-outline-primary">
            ← Back to all posts
          </a>

          <a
            href="/posts/<%= post.id %>/edit"
            class="btn btn-outline-primary"
          >
            Edit article
          </a>
        </div>
      </div>

    </article>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <p class="mb-0 text-body-secondary">
        Write something worth sharing.
      </p>
    </div>
  </footer>
</body>
</html>
