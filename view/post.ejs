
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= post.title %> | My Blog</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="site-header">
    <nav class="navbar navbar-expand-lg">
      <div class="container">
        <a class="navbar-brand" href="/">My Blog</a>
        <a href="/" class="btn btn-outline-primary">All posts</a>
      </div>
    </nav>
  </header>

  <main class="container py-5">
    <article class="form-shell mx-auto w-100">

      <h1 class="mb-4"><%= post.title %></h1>

      <div class="post-content">
        <%- post.contentHtml %>
      </div>

      <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
        <a href="/" class="btn btn-outline-primary">
          ← Back to all posts
        </a>

        <a
          href="/posts/<%= post.id %>/edit"
          class="btn btn-outline-primary"
        >
          Edit
        </a>
      </div>

    </article>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <p class="mb-0 text-body-secondary">
        Write something worth sharing.
      </p>
    </div>
  </footer>
</body>
</html>
